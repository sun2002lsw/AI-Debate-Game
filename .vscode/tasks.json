{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clear Terminal",
      "type": "shell",
      "command": "cls",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "Start Frontend Dev",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "Stop Frontend Dev",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Get-NetTCPConnection -LocalPort 5173 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }"
      ]
    }
  ]
}
